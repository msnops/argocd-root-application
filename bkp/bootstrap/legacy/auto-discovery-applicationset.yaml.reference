apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet

metadata:
  name: root-application
  namespace: argocd

spec:
  goTemplate: true

  goTemplateOptions:
    - missingkey=error

  # Auto-discovers every cluster by reading each cluster_values.yaml file.
  # Adding a new cluster = adding a new folder under eks_new/clusters/,
  # no changes needed here.
  generators:
    - git:
        repoURL: https://github.com/msnops/argocd-root-application.git
        revision: main
        files:
          - path: "eks_new/clusters/*/cluster_values.yaml"

  template:
    metadata:
      name: 'gitops-agent-{{ .path.basename }}'
      finalizers:
        - resources-finalizer.argocd.argoproj.io

    spec:
      project: '{{ .cluster.project }}'

      sources:
        # The applicationsets chart itself
        - repoURL: https://github.com/msnops/argocd-root-application.git
          targetRevision: main
          path: eks_new/applicationsets

          helm:
            releaseName: 'gitops-agent-{{ .cluster.gitopsAgentId | lower | replace "_" "-" }}'

            # Layer 1: environment defaults (environmentApps, etc.)
            # Layer 2: cluster overrides (clusterApps, cluster identity)
            valueFiles:
              - '$values/eks_new/environments/{{ .cluster.environment }}/values.yaml'
              - '$values/eks_new/clusters/{{ .cluster.name }}/cluster_values.yaml'

            parameters:
              - name: clusterName
                value: '{{ .cluster.name }}'
              - name: gitopsAgentId
                value: '{{ .cluster.gitopsAgentId }}'
              - name: gitopsNamespace
                value: argocd
              - name: repoURL
                value: https://github.com/msnops/argocd-root-application.git
              - name: targetRevision
                value: main

        # Values repository (so $values/... refs above resolve)
        - repoURL: https://github.com/msnops/argocd-root-application.git
          targetRevision: main
          ref: values

      destination:
        server: https://kubernetes.default.svc
        namespace: argocd

      syncPolicy:
        automated:
          prune: true
          selfHeal: true
          allowEmpty: false

        retry:
          limit: 5
          backoff:
            duration: 5s
            factor: 2
            maxDuration: 3m

        syncOptions:
          - CreateNamespace=true
          - PrunePropagationPolicy=foreground
          - PruneLast=true