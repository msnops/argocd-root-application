{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": ["repoURL", "targetRevision", "gitopsNamespace", "cluster"],
  "properties": {
    "repoURL": { "type": "string", "minLength": 1 },
    "targetRevision": { "type": "string", "minLength": 1 },
    "gitopsNamespace": { "type": "string", "minLength": 1 },
    "applicationSetChartPath": { "type": "string", "minLength": 1 },
    "cluster": {
      "type": "object",
      "required": ["name", "environment", "server", "project", "gitopsAgentId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "server": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "gitopsAgentId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
